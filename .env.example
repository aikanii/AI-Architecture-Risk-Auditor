# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# Application
LOG_LEVEL=INFO
DEBUG=false

# Scanning
SCAN_TIMEOUT_MINUTES=10
MAX_WORKERS=4

# Parser caching
ENABLE_AST_CACHE=true
CACHE_DIR=./cache

# Semgrep
SEMGREP_CONFIG_URL=https://semgrep.dev/c/owasp-top-ten
SEMGREP_TIMEOUT=300

# Risk thresholds
SPOF_FAN_IN_THRESHOLD=3
BOUNDARY_CROSSING_THRESHOLD=5

# Security
REDACT_SECRETS_IN_LOGS=true
REDACT_SECRETS_IN_REPORTS=true
SECRETS_HASH_SALT=your-random-salt-here
